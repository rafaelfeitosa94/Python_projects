         alt="Mané">
    <div class="mane-subtitle">Forecast de Vendas</div>
</div>
<div class="mane-divider"></div>
""", unsafe_allow_html=True)

# =========================================================
# VERIFICA DADOS
# =========================================================

if len(df_mensal) < 3:
    st.warning("Dados insuficientes para projeção (mínimo 3 meses com vendas).")
    st.stop()

# =========================================================
# KPI CARDS
# =========================================================

total_vendas = df_filtrado["VALOR"].sum()
total_qtd    = df_filtrado["QUANTIDADE"].sum()
ticket_medio = total_vendas / total_qtd if total_qtd > 0 else 0
media_mensal = df_mensal["VALOR"].mean()

def fmt_brl(v):
    return f"{v:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")

st.markdown(f"""
