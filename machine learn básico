C_TICK    = "#44445a"

fig = go.Figure()

# Banda de incerteza
fig.add_trace(go.Scatter(
    x         = fut_datas + fut_datas[::-1],
    y         = fut_melhor + fut_pior[::-1],
    fill      = "toself",
    fillcolor = C_BANDA,
    line      = dict(color="rgba(0,0,0,0)"),
    hoverinfo = "skip",
    showlegend = True,
    name      = f"Banda ±{intervalo_confianca}%",
))

# Histórico real
fig.add_trace(go.Scatter(
    x      = hist_datas,
    y      = hist_valores,
    mode   = "lines+markers",
    name   = "Histórico Real",
    line   = dict(color=C_HIST, width=2.5, shape="spline", smoothing=0.7),
    marker = dict(size=7, color=C_HIST, line=dict(color="#08080f", width=2.5)),
))

# Ajuste do modelo (fitted)
fig.add_trace(go.Scatter(
    x    = hist_datas,
    y    = fitted_valores,
    mode = "lines",
    name = "Ajuste do Modelo",
    line = dict(color=C_FITTED, width=1.5, dash="dot", shape="spline", smoothing=0.7),
))

# Pior cenário
fig.add_trace(go.Scatter(
    x    = fut_datas,
    y    = fut_pior,
    mode = "lines",
    name = "Pior Cenário",
    line = dict(color=C_PIOR, width=1.8, dash="dash", shape="spline", smoothing=0.6),
))

# Melhor cenário
fig.add_trace(go.Scatter(
    x    = fut_datas,
    y    = fut_melhor,
    mode = "lines",
    name = "Melhor Cenário",
    line = dict(color=C_MELHOR, width=1.8, dash="dash", shape="spline", smoothing=0.6),
))

# Projeção central
fig.add_trace(go.Scatter(
    x      = fut_datas,
    y      = fut_central,
    mode   = "lines+markers",
    name   = "Projeção Base",
    line   = dict(color=C_PROJ, width=3, shape="spline", smoothing=0.7),
    marker = dict(size=8, symbol="diamond", color=C_PROJ, line=dict(color="#08080f", width=2.5)),
))

# Linha divisória
fig.add_vline(
    x                   = ult_data.timestamp() * 1000,
    line_width          = 1,
    line_dash           = "dot",
    line_color          = "rgba(239,68,68,0.35)",
