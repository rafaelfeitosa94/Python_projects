    annotation_position = "top",
    annotation_font     = dict(color="rgba(239,68,68,0.6)", size=10.5, family="DM Sans"),
)

fig.update_layout(
    paper_bgcolor = "rgba(0,0,0,0)",
    plot_bgcolor  = "rgba(0,0,0,0)",
    height        = 520,
    margin        = dict(l=10, r=20, t=35, b=10),
    hovermode     = "x unified",
    hoverlabel    = dict(
        bgcolor    = "#181830",
