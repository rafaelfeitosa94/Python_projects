        <div class="kpi-value"><span>R$</span>{fmt_brl(ticket_medio)}</div>
    </div>
    <div class="kpi-card">
        <span class="kpi-icon">📊</span>
        <div class="kpi-label">Média Mensal</div>
        <div class="kpi-value"><span>R$</span>{fmt_brl(media_mensal)}</div>
    </div>
</div>
""", unsafe_allow_html=True)

# =========================================================
# MODELO DE PREVISÃO
# =========================================================

n = len(df_mensal)
usar_prophet = PROPHET_OK and n >= 6

ult_data  = df_mensal["DATA"].max()
datas_fut = [ult_data + relativedelta(months=i) for i in range(1, meses_previsao + 1)]

# ── Prophet ───────────────────────────────────────────────
if usar_prophet:

    df_prophet      = df_mensal.rename(columns={"DATA": "ds", "VALOR": "y"})[["ds", "y"]]
    intervalo_width = intervalo_confianca / 100

    modelo = Prophet(
        interval_width          = intervalo_width,
        yearly_seasonality      = (n >= 12),
        weekly_seasonality      = False,
        daily_seasonality       = False,
        seasonality_mode        = "multiplicative",
        changepoint_prior_scale = 0.15,
    )

    modelo.fit(df_prophet)

    future   = modelo.make_future_dataframe(periods=meses_previsao, freq=_freq)
    forecast = modelo.predict(future)

    fc_hist = forecast[forecast["ds"].isin(df_prophet["ds"])][["ds","yhat","yhat_lower","yhat_upper"]]
    fc_fut  = forecast[~forecast["ds"].isin(df_prophet["ds"])][["ds","yhat","yhat_lower","yhat_upper"]]

    hist_datas     = df_mensal["DATA"].tolist()
    hist_valores   = df_mensal["VALOR"].tolist()
    fut_datas      = fc_fut["ds"].tolist()
    fut_central    = fc_fut["yhat"].clip(lower=0).tolist()
    fut_melhor     = fc_fut["yhat_upper"].clip(lower=0).tolist()
    fut_pior       = fc_fut["yhat_lower"].clip(lower=0).tolist()
    fitted_valores = fc_hist["yhat"].clip(lower=0).tolist()
    modelo_nome    = "Prophet — Tendência + Sazonalidade"

# ── Holt-Winters ETS ──────────────────────────────────────
else:

    serie = df_mensal.set_index("DATA")["VALOR"].asfreq(_freq)

    if n >= 12:
        trend, seasonal, seasonal_p = "add", "add", 12
    elif n >= 6:
        trend, seasonal, seasonal_p = "add", None, None
    else:
        trend, seasonal, seasonal_p = None, None, None

    modelo = ExponentialSmoothing(
        serie,
        trend=trend, seasonal=seasonal,
        seasonal_periods=seasonal_p,
        initialization_method="estimated",
    ).fit(optimized=True)

    prev        = modelo.forecast(meses_previsao)
    fut_central = prev.clip(lower=0).tolist()

    residuos = (serie - modelo.fittedvalues).dropna()
    std_res  = residuos.std()

    z_map = {50:0.674, 60:0.842, 70:1.036, 80:1.282, 90:1.645, 95:1.960}
    z_val = z_map.get(intervalo_confianca, 1.282)

    fut_melhor     = [max(0, v + z_val * std_res * np.sqrt(i+1)) for i, v in enumerate(fut_central)]
    fut_pior       = [max(0, v - z_val * std_res * np.sqrt(i+1)) for i, v in enumerate(fut_central)]
    hist_datas     = df_mensal["DATA"].tolist()
    hist_valores   = df_mensal["VALOR"].tolist()
    fut_datas      = datas_fut
    fitted_valores = modelo.fittedvalues.clip(lower=0).tolist()
    modelo_nome    = "Holt-Winters ETS — Suavização Exponencial"

# =========================================================
# GRÁFICO
# =========================================================

# Paleta
C_HIST    = "#f87171"              # red-400
C_FITTED  = "rgba(248,113,113,0.45)"
C_PROJ    = "#ef4444"              # red-500
C_MELHOR  = "#4ade80"              # green-400
C_PIOR    = "#fb923c"              # orange-400
C_BANDA   = "rgba(239,68,68,0.06)"
