    f"mssql+pyodbc://{USERNAME}:{PASSWORD}@{SERVER}/{DATABASE}"
    "?driver=ODBC+Driver+17+for+SQL+Server"
)

engine = create_engine(connection_string)

# =========================================================
# QUERY
# =========================================================

query = """
{sua query em sql}
"""

# =========================================================
# LOAD DATA
# =========================================================

@st.cache_data
def load_data():
    df = pd.read_sql(query, engine)
    return df

df = load_data()

# =========================================================
# SIDEBAR FILTROS
# =========================================================

st.sidebar.title("Filtros")

lista_lojas    = sorted(df["LOJA"].dropna().unique())
lista_produtos = sorted(df["PRODUTO"].dropna().unique())

loja    = st.sidebar.selectbox("Selecione a Loja",    ["TODAS"] + list(lista_lojas))
produto = st.sidebar.selectbox("Selecione o Produto", ["TODOS"] + list(lista_produtos))

meses_previsao = st.sidebar.slider(
    "Meses de Previsão", min_value=1, max_value=24, value=12, step=1
)

intervalo_confianca = st.sidebar.slider(
    "Intervalo de Confiança (%)", min_value=50, max_value=95, value=80, step=5
)

# =========================================================
# FILTROS
# =========================================================

df_filtrado = df.copy()
if loja    != "TODAS": df_filtrado = df_filtrado[df_filtrado["LOJA"]    == loja]
if produto != "TODOS": df_filtrado = df_filtrado[df_filtrado["PRODUTO"] == produto]

# =========================================================
# AGRUPAMENTO MENSAL
# =========================================================

df_filtrado["DATA"] = pd.to_datetime(df_filtrado["DATA"])
_freq = "ME" if pd.__version__ >= "2.2" else "M"

df_mensal = (
    df_filtrado
    .groupby(pd.Grouper(key="DATA", freq=_freq))
    .agg(VALOR=("VALOR", "sum"), QUANTIDADE=("QUANTIDADE", "sum"))
    .reset_index()
    .sort_values("DATA")
)

df_mensal = df_mensal[df_mensal["VALOR"] > 0].reset_index(drop=True)

# =========================================================
# HEADER — Logo centralizada
# =========================================================

