# =========================================================
# HELPER — bandas de confiança calibradas e proporcionais
# =========================================================

def _calcular_std_percentual(hist_valores):
    """
    Calcula o coeficiente de variação (CV) da série histórica.
    Usar % em vez de valor absoluto garante que as bandas
    sejam proporcionais à magnitude dos dados — não explodem
    em séries de alto valor nem desaparecem em séries pequenas.
    """
    arr  = np.array(hist_valores, dtype=float)
    mean = float(np.mean(arr))
    if mean <= 0:
        return 0.10  # fallback: 10%
    std  = float(np.std(arr)) if len(arr) > 1 else mean * 0.10
    cv   = std / mean
    # CV mínimo de 5% (bandas visíveis) e máximo de 35% (não explodem)
    return float(np.clip(cv, 0.05, 0.35))

def _bandas(central_list, cv, z_val):
    """
    Retorna (melhor, pior) com incerteza proporcional ao valor projetado.
    Crescimento suave pelo horizonte (logarítmico, cap em 1.6x).
    Piso do pior cenário: nunca abaixo de 25% do valor central —
    uma projeção nunca deve chegar a zero para produto com histórico.
    """
    melhor, pior = [], []
    for i, v in enumerate(central_list):
        horizon_factor = min(1.0 + 0.08 * np.log1p(i), 1.6)
        margem = z_val * cv * v * horizon_factor
        melhor.append(v + margem)
        # Piso de 25%: impede que o pior cenário vá a zero ou fique absurdo
        piso = v * 0.25
        pior.append(max(piso, v - margem))
    return melhor, pior

# =========================================================
# MODELO DE PREVISÃO — Ensemble adaptativo (ETS + Tendência Local)
# =========================================================
n = len(df_mensal)

ult_data  = df_mensal["DATA"].max()

fut_datas = [ult_data + relativedelta(months=i) for i in range(1, meses_previsao + 1)]

z_map = {50: 0.674, 60: 0.842, 70: 1.036, 80: 1.282, 90: 1.645, 95: 1.960}
z_val = z_map.get(intervalo_confianca, 1.282)

hist_datas   = df_mensal["DATA"].tolist()
hist_valores = df_mensal["VALOR"].tolist()

serie = df_mensal.set_index("DATA")["VALOR"].asfreq(_freq)

# ── 1. Índices sazonais manuais (para n < 24) ─────────────
def calcular_indices_sazonais(valores):
    """
    Calcula índices sazonais mês a mês a partir do histórico disponível.
    Usa média de cada mês relativa à média geral.
    Funciona com qualquer tamanho >= 6 meses.
    """
    arr = np.array(valores, dtype=float)
    media_geral = arr.mean()
    if media_geral <= 0:
        return np.ones(12)

    # Monta matriz mês × anos (preenche com NaN onde não há dado)
    n_anos = int(np.ceil(len(arr) / 12))
    matriz = np.full((n_anos, 12), np.nan)
    for i, v in enumerate(arr):
        mes_idx = (df_mensal["DATA"].iloc[i].month - 1)  # 0-11
        ano_idx = i // 12
        if ano_idx < n_anos:
            if np.isnan(matriz[ano_idx, mes_idx]):
                matriz[ano_idx, mes_idx] = v
            else:
                matriz[ano_idx, mes_idx] += v  # soma se houver duplicata de mês

    # Índice de cada mês = média do mês / média geral
    indices = np.nanmean(matriz, axis=0) / media_geral
    # Normaliza para que a média dos índices seja 1.0
    indices = indices / np.nanmean(indices)
    # Substitui NaN (meses sem dado) por 1.0
    indices = np.where(np.isnan(indices), 1.0, indices)
    return indices

# ── 2. ETS sem sazonalidade (base de tendência) ───────────
if n >= 24:
    trend_ets, seas_ets, seas_p = "add", "add", 12
    ets_label = "Trend + Sazonalidade"
    usar_sazonal_manual = False
elif n >= 6:
    trend_ets, seas_ets, seas_p = "add", None, None
    ets_label = "Trend + Sazonalidade Manual"
    usar_sazonal_manual = True
else:
    trend_ets, seas_ets, seas_p = None, None, None
    ets_label = "Suavização Simples"
    usar_sazonal_manual = True

try:
    modelo_ets = ExponentialSmoothing(
        serie,
        trend=trend_ets,
        seasonal=seas_ets,
        seasonal_periods=seas_p,
        initialization_method="estimated",
    ).fit(optimized=True)
except Exception:
    modelo_ets = ExponentialSmoothing(
        serie, trend=None, seasonal=None,
        initialization_method="estimated",
    ).fit(optimized=True)
    ets_label  = "Suavização Simples (fallback)"
    usar_sazonal_manual = True

prev_ets_raw = modelo_ets.forecast(meses_previsao).tolist()

# ── 3. Aplica sazonalidade manual sobre a projeção ETS ────
if usar_sazonal_manual and n >= 6:
    indices_saz = calcular_indices_sazonais(hist_valores)
    mes_inicio  = (ult_data.month % 12)  # próximo mês (0-indexed)
    prev_ets = [
        float(prev_ets_raw[i] * indices_saz[(mes_inicio + i) % 12])
        for i in range(meses_previsao)
    ]
else:
    prev_ets = prev_ets_raw

# ── 4. Fitted values ──────────────────────────────────────
fitted_raw = modelo_ets.fittedvalues
fitted_valores = []
for d in hist_datas:
    try:
        fv = fitted_raw.loc[d]
        fitted_valores.append(max(0.0, float(fv)))
    except KeyError:
        idx = hist_datas.index(d)
        fitted_valores.append(float(hist_valores[idx]))

# ── 5. Regressão local ponderada (tendência recente) ──────
janela_reg = min(12, n)
y_reg = np.array(hist_valores[-janela_reg:], dtype=float)
x_reg = np.arange(janela_reg, dtype=float)

pesos = np.exp(0.3 * (x_reg - (janela_reg - 1)))
pesos /= pesos.sum()

x_mean = np.average(x_reg, weights=pesos)
y_mean = np.average(y_reg, weights=pesos)
slope  = np.sum(pesos * (x_reg - x_mean) * (y_reg - y_mean)) / \
         np.sum(pesos * (x_reg - x_mean) ** 2)
intercept = y_mean - slope * x_mean

ancora = float(y_reg[-1])

# Amortece slope extremo (> 15% ao mês relativo à âncora)
if ancora > 0 and abs(slope / ancora) > 0.15:
    slope = np.sign(slope) * 0.15 * ancora
    intercept = ancora - slope * (janela_reg - 1)

prev_tendencia = [
    float(intercept + slope * (janela_reg + i))
    for i in range(meses_previsao)
]

# Se sazonalidade manual, aplica sobre a tendência local também
if usar_sazonal_manual and n >= 6:
    prev_tendencia = [
        float(prev_tendencia[i] * indices_saz[(mes_inicio + i) % 12])
        for i in range(meses_previsao)
    ]

# ── 6. Ensemble ponderado ─────────────────────────────────
if n < 12:
    w_ets = 0.30
elif n < 24:
    w_ets = 0.30 + (n - 12) / 12 * 0.50
else:
    w_ets = 0.80

