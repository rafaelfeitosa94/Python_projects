def classificar_abc(grupo):
    grupo = grupo.sort_values("VALOR", ascending=False).copy()
    total = grupo["VALOR"].sum()
    if total == 0:
        grupo["ABC"] = "C"
        grupo["PERC_ACUM"] = 0.0
        return grupo
    grupo["PERC_ACUM"] = grupo["VALOR"].cumsum() / total * 100
    grupo["ABC"] = grupo["PERC_ACUM"].apply(
        lambda x: "A" if x <= 80 else ("B" if x <= 95 else "C")
    )
    return grupo

