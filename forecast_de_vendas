# ── 7. Bandas de confiança ────────────────────────────────
residuos = (serie - fitted_raw).dropna()
if len(residuos) > 1 and media_hist > 0:
    cv = float(np.clip(residuos.abs().mean() / media_hist, 0.05, 0.35))
else:
    cv = _calcular_std_percentual(hist_valores)

